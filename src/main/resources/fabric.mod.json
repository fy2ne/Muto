{
  "schemaVersion": 1,
  "id": "muto",
  "version": "${version}",
  "name": "Muto Runtime",
  "description": "Hot-swap engine for Fabric mods. Load, unload, and update jars at runtime with no JVM restart.",
  "authors": [
    "fy2ne"
  ],
  "contact": {
    "homepage": "https://muto.fy2ne.me",
    "sources": "https://github.com/fy2ne/muto",
    "issues": "https://github.com/fy2ne/muto/issues"
  },
  "license": "Apache-2.0",
  "icon": "assets/muto/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "me.fy2ne.muto.MutoMod"
    ]
  },
  "mixins": [
    "muto.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "fabric-api": ">=0.144.1",
    "minecraft": ">=26.1 <27.0",
    "java": ">=25"
  }
}
