{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "muto",
  "main": "./worker.js",
  "compatibility_date": "2026-10-09",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "emaildash-db",
      "database_id": "3e34f54b-1c40-418f-b5c7-69b9e2ce7f16"
    }
  ],
  "routes": [
    {
      "pattern": "muto.fy2ne.me",
      "custom_domain": true
    }
  ]
}
